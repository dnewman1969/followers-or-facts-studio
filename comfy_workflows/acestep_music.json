{
  "_about": "ACE-Step instrumental music bed (ComfyUI API format). Model: checkpoints/ace_step_v1_3.5b.safetensors (Apache-2.0). Placeholders: TAGS, LYRICS, SECONDS, SEED, FILENAME_PREFIX. If you install ACE-Step 1.5, export its ComfyUI template in API format and put the same placeholders in.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "ace_step_v1_3.5b.safetensors"}
  },
  "2": {
    "class_type": "TextEncodeAceStepAudio",
    "inputs": {"clip": ["1", 1], "tags": "{{TAGS}}", "lyrics": "{{LYRICS}}", "lyrics_strength": 0.99}
  },
  "3": {
    "class_type": "ConditioningZeroOut",
    "inputs": {"conditioning": ["2", 0]}
  },
  "4": {
    "class_type": "EmptyAceStepLatentAudio",
    "inputs": {"seconds": "{{SECONDS}}", "batch_size": 1}
  },
  "5": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["1", 0], "shift": 5.0}
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0],
      "seed": "{{SEED}}", "steps": 50, "cfg": 5.0, "sampler_name": "euler",
      "scheduler": "simple", "denoise": 1.0
    }
  },
  "7": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["6", 0], "vae": ["1", 2]}
  },
  "8": {
    "class_type": "SaveAudio",
    "inputs": {"audio": ["7", 0], "filename_prefix": "{{FILENAME_PREFIX}}"}
  }
}
