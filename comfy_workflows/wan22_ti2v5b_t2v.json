{
 "_about": "Wan 2.2 TI2V-5B text-to-video (ComfyUI API format). Apache-2.0. Files: diffusion_models/wan2.2_ti2v_5B_fp16.safetensors, text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors, vae/wan2.2_vae.safetensors (scripts/get-comfy-models.ps1 -TextToVideo downloads them). Native 24 fps, 1280x704. Placeholders: PROMPT, SEED, WIDTH, HEIGHT, FRAMES, FPS, FILENAME_PREFIX. Written from ComfyUI's Wan 2.2 5B example; not yet run on Dave's PC.",
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
   "type": "wan",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "wan2.2_vae.safetensors"
  }
 },
 "4": {
  "class_type": "ModelSamplingSD3",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "shift": 8.0
  }
 },
 "5": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{PROMPT}}"
  }
 },
 "6": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "text, words, watermark, logo, recognizable faces, distorted faces, extra limbs, flicker, jitter, sudden cuts, low quality, blurry, oversaturated"
  }
 },
 "7": {
  "class_type": "Wan22ImageToVideoLatent",
  "inputs": {
   "vae": [
    "3",
    0
   ],
   "width": "{{WIDTH}}",
   "height": "{{HEIGHT}}",
   "length": "{{FRAMES}}",
   "batch_size": 1
  }
 },
 "8": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "4",
    0
   ],
   "positive": [
    "5",
    0
   ],
   "negative": [
    "6",
    0
   ],
   "latent_image": [
    "7",
    0
   ],
   "seed": "{{SEED}}",
   "steps": 20,
   "cfg": 5.0,
   "sampler_name": "uni_pc",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "9": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "8",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "10": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "9",
    0
   ],
   "fps": "{{FPS}}"
  }
 },
 "11": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "10",
    0
   ],
   "filename_prefix": "{{FILENAME_PREFIX}}",
   "format": "mp4",
   "codec": "h264"
  }
 }
}